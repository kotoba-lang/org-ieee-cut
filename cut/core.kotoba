;; cut -- POSIX cut (IEEE Std 1003.1), the single-field form.
;;
;;   cut -f N FILE        field N, delimited by TAB
;;   cut -dX -fN FILE     field N, delimited by X
;;
;; ## A line with no delimiter is printed WHOLE
;;
;; That is the behaviour, not an edge case to work around: `cut -d: -f2` over
;; a line reading `nofield` answers `nofield`, not the empty string.
;; (`-s` suppresses such lines; this does not implement `-s`.) Measured
;; against /usr/bin/cut 2026-09-10.
;;
;; ## The default delimiter is a TAB, not a space
;;
;; Measured on the same day: `cut -f2` over `a:b:c` answers `a:b:c` -- the
;; whole line, because there is no tab in it -- and over `one<TAB>two` it
;; answers `two`.
;;
;; A tab cannot be written in Kotoba source (no control characters, no
;; char-to-string builtin), so it is cut from the listing wire's own
;; separator the same way a newline is cut from a two-line literal.
;;
;; Capabilities: :cli/args (38), :fs/app-data (35), :io/write (37),
;; :io/write-error (39).
(ns cut.core (:export [main]))

(defn arg [i :string] :string
  (typed-cap-call :cli/args :string :string i))

(defn emit [s :string] :string
  (typed-cap-call :io/write :string :string s))

(defn emit-error [s :string] :string
  (typed-cap-call :io/write-error :string :string s))

(defn slurp-file [path :string] :string
  (typed-cap-call :fs/app-data :string :string path))

(defn readable? [path :string] :bool
  (string=? (typed-cap-call :fs/app-data :string :string
                            (string-concat path "EXISTS_SEP"))
            "1"))

(defn nl [] :string
  (string-substring "a
b" 1 2))

;; A one-byte tab, cut from a literal that contains one.
(defn tab [] :string
  (string-substring "a	b" 1 2))

(defn digit-value [s :string i :i64] :i64
  (let [c (string-code-point-at s i)]
    (if (< c 48) -1 (if (> c 57) -1 (- c 48)))))

(defn text->i64 [s :string i :i64 n :i64 acc :i64] :i64
  (if (>= i n)
    acc
    (let [d (digit-value s i)]
      (if (< d 0) -1 (text->i64 s (+ i 1) n (+ (* acc 10) d))))))

;; --- arguments ------------------------------------------------------------
;; `cut [-dX] [-s] -fLIST FILE...`, and the flags may come in ANY order --
;; measured, `-d: -s -f1`, `-s -d: -f1` and `-d: -f2 -s` are the same request.
;;
;; So the arguments are SCANNED rather than indexed. This used to ask whether
;; argument 0 began with `-d` and take the operand from a fixed offset, which
;; is a positional assumption that `-s` breaks in three different places at
;; once. A scan has no position to be wrong about.
(defn digit-text [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn decimal-of [n :i64] :string
  (if (< n 10)
    (digit-text n)
    (string-concat (decimal-of (quot n 10))
                   (digit-text (- n (* 10 (quot n 10)))))))

(defn dash? [a :string] :bool
  (= (string-index-of a "-") 0))

;; The index of the first argument that is not a flag.
(defn first-file-from [i :i64 total :string] :i64
  (if (string=? (decimal-of i) total)
    i
    (if (dash? (arg (decimal-of i)))
      (first-file-from (+ i 1) total)
      i)))

(defn first-file [] :i64
  (first-file-from 0 (arg "")))

;; The flag beginning with PREFIX, or "" -- searched among the leading flags
;; only, so a FILE named `-f...` is never mistaken for one.
(defn flag-from [i :i64 stop :i64 prefix :string] :string
  (if (>= i stop)
    ""
    (let [a (arg (decimal-of i))]
      (if (= (string-index-of a prefix) 0)
        a
        (flag-from (+ i 1) stop prefix)))))

(defn has-flag? [name :string] :bool
  (string=? (flag-from 0 (first-file) name) name))

(defn suppress? [] :bool
  (has-flag? "-s"))

(defn delim [] :string
  (let [d (flag-from 0 (first-file) "-d")]
    (if (string=? d "") (tab) (string-substring d 2 (string-byte-length d)))))

(defn field-text [] :string
  (let [f (flag-from 0 (first-file) "-f")]
    (if (string=? f "") "" (string-substring f 2 (string-byte-length f)))))

;; --- the field list ------------------------------------------------------
;;
;; `-f` takes a LIST, not a number: `-f2,4`, `-f2-4`, `-f2-`, `-f-3`, and any
;; comma-separated mixture. Measured against /usr/bin/cut 2026-09-10, the
;; list behaves as a SET tested per field rather than a sequence to walk:
;;
;;   -f3,1  -> a:c    the output is ASCENDING, not the order written
;;   -f1,1  -> a      a repeat selects the field once
;;   -f2,9  -> b      a field past the end is skipped, not an error
;;   -f3-1  -> (empty line, exit 0)   a descending range selects nothing
;;
;; So this asks "is field n selected" for n = 1, 2, ... in order. Ascending
;; order, de-duplication and out-of-range skipping all fall out of that; none
;; of them needs a sort, which is fortunate because there is no ordering
;; primitive to sort with.

;; Non-empty and every byte a digit.
(defn all-digits? [s :string i :i64 n :i64] :i64
  (if (= n 0)
    0
    (if (>= i n)
      1
      (if (< (digit-value s i) 0) 0 (all-digits? s (+ i 1) n)))))

;; 0 = well formed, 1 = illegal list value, 2 = value may not include zero.
;; An EMPTY item is 2, not 1: measured, `-f1,` and `-f,1` and `-f` all report
;; "values may not include zero", because an absent number reads as 0. A
;; range with both sides absent (`-f-`) is 2 for the same reason -- while
;; `-f1-` and `-f-1` are both well formed, since there an absent side means
;; unbounded rather than zero.
(defn classify-item [item :string] :i64
  (let [n (string-byte-length item)
        d (string-index-of item "-")]
    (if (= n 0)
      2
      (if (< d 0)
        (if (= (all-digits? item 0 n) 1)
          (if (= (text->i64 item 0 n 0) 0) 2 0)
          1)
        (let [lo (string-substring item 0 d)
              hi (string-substring item (+ d 1) n)
              ln (string-byte-length lo)
              hn (string-byte-length hi)]
          (if (>= (string-index-of hi "-") 0)
            1
            (if (= (+ ln hn) 0)
              2
              (if (= ln 0)
                (if (= (all-digits? hi 0 hn) 1)
                  (if (= (text->i64 hi 0 hn 0) 0) 2 0)
                  1)
                (if (= hn 0)
                  (if (= (all-digits? lo 0 ln) 1)
                    (if (= (text->i64 lo 0 ln 0) 0) 2 0)
                    1)
                  (if (= (all-digits? lo 0 ln) 1)
                    (if (= (all-digits? hi 0 hn) 1)
                      (if (= (text->i64 lo 0 ln 0) 0)
                        2
                        (if (= (text->i64 hi 0 hn 0) 0) 2 0))
                      1)
                    1))))))))))

;; The first item that is not well formed decides, scanning left to right.
(defn classify-spec [spec :string] :i64
  (let [n (string-byte-length spec)
        i (string-index-of spec ",")]
    (if (< i 0)
      (classify-item spec)
      (let [c (classify-item (string-substring spec 0 i))]
        (if (= c 0)
          (classify-spec (string-substring spec (+ i 1) n))
          c)))))

;; An absent low bound is 1; an absent high bound is unbounded, carried here
;; as 0 because a real bound can never be 0 (classify-spec rejected it).
(defn item-selects? [item :string n :i64] :i64
  (let [len (string-byte-length item)
        d (string-index-of item "-")]
    (if (< d 0)
      (if (= (text->i64 item 0 len 0) n) 1 0)
      (let [lo (string-substring item 0 d)
            hi (string-substring item (+ d 1) len)
            ln (string-byte-length lo)
            hn (string-byte-length hi)
            lov (if (= ln 0) 1 (text->i64 lo 0 ln 0))
            hiv (if (= hn 0) 0 (text->i64 hi 0 hn 0))]
        (if (< n lov)
          0
          (if (= hiv 0) 1 (if (<= n hiv) 1 0)))))))

(defn spec-selects? [spec :string n :i64] :i64
  (let [len (string-byte-length spec)
        i (string-index-of spec ",")]
    (if (< i 0)
      (item-selects? spec n)
      (if (= (item-selects? (string-substring spec 0 i) n) 1)
        1
        (spec-selects? (string-substring spec (+ i 1) len) n)))))

;; --- the field walk ------------------------------------------------------

;; The nth field of LINE, or the WHOLE line when the delimiter does not occur
;; in it, or the empty string when the line has fewer fields than n.
(defn nth-field [line :string d :string n :i64] :string
  (let [i (string-index-of line d)]
    (if (< i 0)
      ;; Out of delimiters. At n = 1 the remainder IS the last field; past it
      ;; the line has fewer fields than were asked for and the answer is
      ;; empty.
      ;;
      ;; Returning the remainder here instead was wrong in a way only one
      ;; case showed: `-f4` over a three-field line answered `c` where cut
      ;; answers nothing, and `-f1` `-f2` `-f3` all agreed. The line with NO
      ;; delimiter at all is a different question, and `field-of` below asks
      ;; it before this walk starts.
      (if (= n 1) line "")
      (if (= n 1)
        (string-substring line 0 i)
        (nth-field (string-substring line (+ i (string-byte-length d))
                                     (string-byte-length line))
                   d (- n 1))))))

;; How many fields the line has: one more than the number of delimiters.
(defn field-count [line :string d :string acc :i64] :i64
  (let [i (string-index-of line d)]
    (if (< i 0)
      acc
      (field-count (string-substring line (+ i (string-byte-length d))
                                     (string-byte-length line))
                   d (+ acc 1)))))

;; The selected fields are joined by the delimiter, which means the separator
;; goes BETWEEN them and not before the first. Carrying a "have I written
;; anything yet" flag alongside line, delimiter, spec, index and total would
;; be six parameters, and the compiler admits five
;; (`kotoba.compiler.frontend/max-parameters`, an ABI arity limit rather than
;; a language decision -- if it moves, this splits back into one function).
;; So the first selected field is found first and written bare, and every
;; later one is written WITH a leading delimiter. No flag needed.

;; The first selected field at or after n, or 0 when there is none.
(defn first-selected [spec :string n :i64 total :i64] :i64
  (if (> n total)
    0
    (if (= (spec-selects? spec n) 1) n (first-selected spec (+ n 1) total))))

(defn emit-rest [line :string d :string spec :string n :i64 total :i64] :i64
  (if (> n total)
    0
    (do
      (if (= (spec-selects? spec n) 1)
        (do (emit d) (emit (nth-field line d n)))
        "")
      (emit-rest line d spec (+ n 1) total))))

(defn emit-fields [line :string d :string spec :string total :i64] :i64
  (let [f (first-selected spec 1 total)]
    (if (= f 0)
      0
      (do
        (emit (nth-field line d f))
        (emit-rest line d spec (+ f 1) total)))))

;; A line with NO delimiter at all is printed WHOLE, whatever the list says
;; -- measured: `cut -d: -f1,3` over `nofield` answers `nofield`. That is a
;; different question from a line that has the delimiter but too few fields,
;; which contributes nothing.
;; -s suppresses exactly the lines this echoes whole: those with no
;; delimiter. Measured -- an EMPTY line has no delimiter either, so `-s` drops
;; it too, which is why the fixtures include one.
(defn emit-line [line :string d :string spec :string] :i64
  (if (< (string-index-of line d) 0)
    (if (suppress?) 0 (do (emit line) 0))
    (emit-fields line d spec (field-count line d 1))))

;; A last line with NO trailing newline: cut adds one when it EXTRACTED a
;; field and does not when it echoed an undelimited line whole. Measured
;; 2026-09-10 -- `cut -d: -f1` over `nonl-x:nonl-y` answers `nonl-x\n` (7
;; bytes) and over `g` answers `g` (1 byte, no newline).
;;
;; The single-operand suite could not see this: every undelimited fixture
;; ended in a newline. It surfaced only once two operands were compared,
;; because the missing terminator makes the NEXT operand's output look as
;; though it ran on.
(defn walk [rest :string d :string spec :string] :i64
  (let [i (string-index-of rest "\n")]
    (if (< i 0)
      (if (= (string-byte-length rest) 0)
        0
        (do (emit-line rest d spec)
            (if (>= (string-index-of rest d) 0) (emit (nl)) "")
            0))
      (do
        (emit-line (string-substring rest 0 i) d spec)
        ;; A suppressed line contributes no newline either -- otherwise -s
        ;; would replace each dropped line with a blank one.
        (if (if (suppress?)
              (< (string-index-of (string-substring rest 0 i) d) 0)
              false)
          ""
          (emit (nl)))
        (walk (string-substring rest (+ i 1) (string-byte-length rest)) d spec)))))

(defn complain [path :string] :i64
  (do
    (emit-error "cut: ")
    (emit-error path)
    (emit-error ": No such file or directory")
    (emit-error (nl))
    1))

;; --- several operands ----------------------------------------------------
;;
;; Each operand is cut on its own, exactly as sort reads each of its own
;; operands as lines. There are no headers, so the outputs simply follow one
;; another.
;;
;; What makes two operands look like one byte stream is the rule above, not
;; concatenation. Measured 2026-09-10, with `g` holding one undelimited and
;; unterminated line:
;;
;;   cut -d: -f1 g colon   ->  ga / d      `g` had no newline, so `a` follows it
;;   cut -d: -f1 nl2 colon ->  nonl-x / a / d   a field WAS cut, so it did
;;
;; The first of those was read as "cut concatenates its operands" for about
;; an hour. It does not; the previous operand's output was simply
;; unterminated. The two cases together are what distinguish the models, and
;; both are in the suite.
(defn each [i :i64 total :string spec :string worst :i64] :i64
  (if (string=? (decimal-of i) total)
    worst
    (let [path (arg (decimal-of i))]
      (if (readable? path)
        (do (walk (slurp-file path) (delim) spec)
            (each (+ i 1) total spec worst))
        (do (complain path) (each (+ i 1) total spec 1))))))

(defn main [] :i64
  (let [spec (field-text)
        total (arg "")
        start (first-file)
        bad (classify-spec spec)]
    (if (= bad 1)
      (do
        (emit-error "cut: [-bcf] list: illegal list value")
        (emit-error (nl))
        1)
      (if (= bad 2)
        (do
          (emit-error "cut: [-bcf] list: values may not include zero")
          (emit-error (nl))
          1)
        ;; `start` already at the end means there is no file operand. POSIX
        ;; reads standard input; there is no stdin capability, so this
        ;; refuses rather than pretending to have read an empty one.
        (if (string=? (decimal-of start) total)
          1
          (each start total spec 0))))))
